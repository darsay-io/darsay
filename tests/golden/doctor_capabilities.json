  "doctor_version": "1.0.0",
  "environment_variables": [
    {
      "name": "DARSAY_HOME",
      "purpose": "default vault path",
      "secret": false
    },
    {
      "name": "DARSAY_CONFIG",
      "purpose": "explicit operator configuration path",
      "secret": false
    },
    {
      "name": "XDG_CONFIG_HOME",
      "purpose": "base for default operator configuration",
      "secret": false
    }
  ],
  "exit_codes": {
    "0": "healthy or requested mutation completed",
    "1": "findings detected",
    "2": "partial diagnosis or unresolved findings after fix",
    "3": "fix failed and rollback was attempted",
    "4": "unsafe mutation or undo refused",
    "5": "another doctor mutation holds the lock",
    "6": "online diagnostics unavailable",
    "64": "usage error",
    "66": "input or run not found",
    "73": "cannot create artifact or lock",
    "74": "I/O error"
  },
  "fixers": [
    {
      "check_id": "bundle.readme",
      "default": true,
      "id": "bundle.readme.regenerate",
      "risk": "low"
    },
    {
      "check_id": "bundle.sha256sums",
      "default": true,
      "id": "bundle.sha256sums.regenerate",
      "risk": "low"
    },
    {
      "check_id": "runtime.hydration",
      "default": true,
      "id": "runtime.hydration.quarantine",
      "risk": "low"
    },
    {
      "check_id": "transfer.lock",
      "default": true,
      "id": "transfer.lock.quarantine",
      "risk": "low"
    }
  ],
  "identity": {
    "name": "darsay",
    "version": "[TOOL_VERSION]"
  },
  "network": {
    "checks": [],
    "default": "disabled"
  },
  "platforms": [
    "linux",
    "macos"
  ],
  "privilege": "current user only; privilege escalation is never attempted",
  "report_schema": {
    "required": [
      "schema_version",
      "run_id",
      "status",
      "summary",
      "findings",
      "exit_code",
      "artifacts_created",
      "network_attempts",
      "target_actions"
    ],
    "version": 1
  },
  "run_artifacts": [
    "run.json",
    "report.json",
    "report.md",
    "scorecard.json",
    "actions.jsonl",
    "backups/",
    "quarantine/",
    "stdout.json",
    "stderr.log",
    "undo.sh"
  ],
  "schema_version": 1,
  "side_effects": {
    "diagnose": [
      "creates private evidence under <vault>/.doctor"
    ],
    "fix": [
      "regenerates derived bundle README.md files",
      "quarantines stale transfer.lock and hydration.json files"
    ],
    "never": [
      "changes payload bytes",
      "changes curation.md",
      "uses the network",
      "escalates privileges"
    ]
  },
  "supported_subcommands": [
    "diagnose",
    "fix",
    "undo",
    "explain",
    "capabilities",
    "health",
    "robot-docs",
    "ls",
    "diff",
    "gc"
  ],
  "timeouts": {
    "default_budget_seconds": null,
    "health_target_ms": 200
  },
  "tool": "darsay",
  "tool_version": "[TOOL_VERSION]",
  "write_scope": [
    "<vault>/.doctor/**",
    "<vault>/*/*/README.md",
    "<vault>/*/*/transfer.lock",
    "<vault>/*/*/hydration.json"
  ]
}
